# English AI — Python/Flask. Copy to .env; never commit credentials.
APP_ENV=development
PORT=5000
# Empty in development generates a temporary session secret. Required in production.
SECRET_KEY=
# Empty uses instance/english-ai.db. Legacy Node database is never overwritten.
DATABASE_URL=
AUTH_TOKEN_TTL_HOURS=72

# Explicit demonstration mode; use anthropic only with a server-side API key.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_EFFORT=low
AI_TIMEOUT_MS=20000
AI_MAX_HISTORY_MESSAGES=12
CONVERSATION_RETENTION_DAYS=90

# outbox writes development mail locally, smtp sends real mail, disabled sends none.
MAIL_TRANSPORT=outbox
MAIL_OUTBOX_DIR=
APP_PUBLIC_URL=http://localhost:5000
MAIL_FROM=English AI <no-reply@english-ai.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_TTL_MINUTES=15

# In-memory limits are for one development instance; use a shared backend in production.
RATELIMIT_STORAGE_URI=memory://
