# Production requirements. Inject secrets securely; never commit .env or values.
APP_ENV=production
SECRET_KEY=
APP_PUBLIC_URL=https://english.example.com
AUTO_INIT_DB=false
DATABASE_URL=sqlite:////srv/english-ai/instance/english-ai.db
# One trusted HTTPS proxy, with Gunicorn reachable only on loopback.
TRUSTED_PROXY_COUNT=1
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
AI_TIMEOUT_MS=20000
AI_MAX_HISTORY_MESSAGES=12
CONVERSATION_RETENTION_DAYS=90
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
PASSWORD_RESET_TTL_MINUTES=15
