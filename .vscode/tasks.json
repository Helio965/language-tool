{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "English AI: instalar dependências",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "English AI: migrar banco configurado",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "flask", "--app", "app", "db", "upgrade"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "English AI: sincronizar conteúdo",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "flask", "--app", "app", "seed"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "English AI: testar Python",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-m", "not browser", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "test", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "English AI: testar interface",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pytest", "-m", "browser", "-q"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
