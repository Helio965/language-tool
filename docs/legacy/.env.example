# =============================================================================
# English AI — variáveis de ambiente (exemplo)
# Copie para `.env` na raiz do projeto: cp .env.example .env
# NUNCA faça commit do arquivo `.env` (ele já está no .gitignore).
# =============================================================================

# ----------------------------------------------------------------------------
# API (apps/api)
# ----------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3333

# Origem permitida para o front-end (CORS). Em desenvolvimento o Vite roda em 5173.
CORS_ORIGIN=http://localhost:5173

# Segredo usado para assinar o token de sessão (cookie httpOnly).
# Obrigatório em produção. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Em desenvolvimento, se ficar vazio, a API gera um segredo temporário a cada inicialização.
AUTH_TOKEN_SECRET=
AUTH_TOKEN_TTL_HOURS=72

# Caminho do banco SQLite (a pasta data/ é ignorada pelo git).
DATABASE_PATH=./data/english-ai.db

# Dias que conversas salvas ficam armazenadas antes da exclusão automática.
CONVERSATION_RETENTION_DAYS=90

# (Opcional) Pasta com o build do front-end para a API servir tudo em um só endereço.
# Ex.: WEB_DIST_PATH=../web/dist  (depois de `npm run build`)
WEB_DIST_PATH=

# ----------------------------------------------------------------------------
# E-mail (boas-vindas e recuperação de senha) — ver docs/EMAIL-AND-AUTH.md
# ----------------------------------------------------------------------------
# Transporte: smtp | outbox | disabled. Se ficar vazio:
#   - com SMTP_HOST preenchido → smtp (envio real);
#   - em desenvolvimento sem SMTP → outbox: os e-mails viram arquivos .html/.json em MAIL_OUTBOX_DIR
#     (abra o .html no navegador para clicar no link). Nada é enviado de verdade;
#   - em produção sem SMTP → disabled (nada é enviado; a API avisa na inicialização).
# "outbox" é recusado em produção.
MAIL_TRANSPORT=
MAIL_OUTBOX_DIR=./data/outbox

# Servidor SMTP. Credenciais ficam SOMENTE aqui no backend (nunca com prefixo VITE_).
# Porta 587 + SMTP_SECURE=false → STARTTLS (obrigatório em produção). Porta 465 → SMTP_SECURE=true.
# Gmail: use uma "senha de app" (com verificação em duas etapas), nunca a senha da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Remetente dos e-mails. Obrigatório em produção com SMTP. Ex.: English AI <no-reply@seudominio.com>
MAIL_FROM=

# Endereço público do front-end, usado para montar os links dos e-mails (nunca o cabeçalho Host).
# Obrigatório em produção com SMTP. Em desenvolvimento, se vazio, usa a primeira origem de CORS_ORIGIN.
APP_PUBLIC_URL=

# Validade do link de redefinição de senha, em minutos (5 a 120).
PASSWORD_RESET_TTL_MINUTES=15

# ----------------------------------------------------------------------------
# Inteligência Artificial
# ----------------------------------------------------------------------------
# mock      → modo demonstração, sem chamadas externas (padrão)
# anthropic → usa a API da Anthropic (requer ANTHROPIC_API_KEY)
AI_PROVIDER=mock

# Chave do provedor de IA. Fica SOMENTE no backend; nunca use prefixo VITE_.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Esforço de raciocínio do modelo: low (padrão, respostas curtas de tutoria), medium ou high.
AI_EFFORT=low

# Quantidade máxima de mensagens anteriores enviadas ao modelo (controle de custo).
AI_MAX_HISTORY_MESSAGES=12
AI_TIMEOUT_MS=20000

# ----------------------------------------------------------------------------
# Front-end (apps/web) — apenas variáveis com prefixo VITE_ chegam ao navegador.
# Não coloque segredos aqui.
# ----------------------------------------------------------------------------
# demo → protótipo navegável 100% no navegador (dados locais, IA simulada)
# http → usa a API real em VITE_API_BASE_URL
VITE_API_MODE=demo
VITE_API_BASE_URL=/api
